{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mosaic",
  "version": "0.3.0",
  "identifier": "dev.izan.mosaic",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mosaic",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Visual organizer for your code projects",
    "longDescription": "Mosaic shows all your code projects as cards, with live Git status, tags and shortcuts. Local-first, no telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "desktopTemplate": "linux/mosaic.desktop" },
      "rpm": { "desktopTemplate": "linux/mosaic.desktop" }
    },
    "windows": {
      "wix": {
        "language": {
          "en-US": {},
          "es-ES": { "localePath": "wix/es-ES.wxl" }
        }
      },
      "nsis": {
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": true
      }
    }
  }
}
